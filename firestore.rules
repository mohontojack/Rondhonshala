rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMenuItem(data) {
      return data.name is string && data.name.size() > 0 &&
             data.category is string &&
             data.price is number && data.price >= 0;
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidMenuItem(request.resource.data);
    }

    match /orders/{orderId} {
      allow create: if true; // Public can place orders
      allow read, update, delete: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true; // Public can submit reviews
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}
